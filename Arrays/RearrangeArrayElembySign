class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        vector<int> ans1;
        vector<int> ans2;
        vector<int>ans;
        for(int i =0; i < nums.size();i++){
            if(nums[i] > 0){
                ans1.push_back(nums[i]);
            }
            if(nums[i] < 0){
                ans2.push_back(nums[i]);
            }
    
        }
        int i = 0;
        int j = 0;
        for(int k =0; k < nums.size();k++){
            if(k % 2 == 0){
                ans.push_back(ans1[i]);
                i++;
            }
            else{
                ans.push_back(ans2[j]);
                j++;
            }
        }
        return ans;
    }
};



class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans(n);

        int pos = 0;
        int neg = 1;

        for(int i = 0; i < n; i++) {
            if(nums[i] > 0) {
                ans[pos] = nums[i];
                pos += 2;
            }
            else {
                ans[neg] = nums[i];
                neg += 2;
            }
        }

        return ans;
    }
};
